Screen {
    background: $background;
    color: $foreground;
    padding: 0 1;
}
#network-status, #dashboard-footer {
    height: auto;
    min-height: 3;
    border: solid $panel-border;
    padding: 0 1;
    background: $background;
}
#network-status {
    max-height: 7;
}
#dashboard-footer {
    height: 3;
}
#pages {
    height: 1fr;
}
ContentTabs {
    height: 2;
    border-bottom: solid $panel-divider;
    margin-bottom: 0;
}
ContentTabs Underline {
    display: none;
}
Tab {
    height: 1;
    padding: 0 2;
    color: $foreground;
    background: $background;
}
Tab.-active, Tabs:focus Tab.-active {
    color: $background;
    background: $primary;
    text-style: bold;
}
TabPane {
    padding: 0;
}
Overview, Proxies, Rules, Connections, Logs, KernelConfig {
    height: 1fr;
}
Overview {
    scrollbar-size-vertical: 1;
}
#metrics {
    layout: grid;
    grid-size: 4 1;
    grid-gutter: 0 1;
    height: 4;
    margin-bottom: 1;
}
.metric {
    height: 4;
    padding: 0 1;
    border: solid $panel-border;
    background: $background;
}
.metric-label, .metric-value {
    height: 1;
}
.metric-label {
    color: $foreground;
}
.metric-value {
    text-style: bold;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}
#overview-grid {
    layout: grid;
    grid-size: 2 3;
    grid-columns: 8fr 5fr;
    grid-rows: 1.2fr 1fr 1fr;
    grid-gutter: 1 1;
    height: 1fr;
    min-height: 32;
}
.dashboard-panel {
    border: solid $panel-border;
    padding: 0 1;
    background: $background;
}
.panel-heading {
    height: 2;
    width: 1fr;
    border-bottom: solid $panel-divider;
    color: $primary;
    text-style: bold;
}
.panel-title {
    width: 1fr;
    height: 1;
}
.panel-action {
    height: 1;
    width: auto;
    min-width: 0;
    border: none;
    padding: 0 0 0 1;
    background: transparent;
    color: $foreground;
    text-style: none;
}
.panel-action:hover, .panel-action:focus {
    border: none;
    background: $primary;
    color: $background;
}
.panel-hint {
    height: 1;
    color: $text-muted;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}
#traffic-legend {
    width: auto;
    height: 1;
}
#traffic-chart {
    height: 1fr;
}
.route-label {
    height: 1;
    color: $text-muted;
}
#mode-options {
    height: 1;
}
.mode-button {
    height: 1;
    width: 1fr;
    min-width: 0;
    border: none;
    padding: 0;
    background: $background;
    color: $foreground;
    text-style: none;
}
.mode-button.selected-mode {
    color: $primary;
}
.mode-button:focus, .mode-button:hover {
    background: $primary;
    color: $background;
    border: none;
}
#quick-group {
    height: 1;
    margin-bottom: 1;
}
#quick-group SelectCurrent {
    border: none;
    padding: 0;
}
#overview-config {
    min-height: 5;
}
#overview-logs, #overview-config {
    height: 1fr;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}
.section-title {
    color: $primary;
    text-style: bold;
    margin: 1 0;
    height: auto;
}
.toolbar {
    height: 3;
    margin: 1 0;
    align-vertical: middle;
}
.toolbar Button {
    margin-right: 1;
    min-width: 10;
}
.toolbar Input {
    width: 1fr;
    min-width: 10;
    margin-right: 1;
}
Input {
    border: tall $panel-divider;
    background: $surface;
}
Input:focus {
    border: tall $primary;
}
Button {
    background: $surface;
}
#proxy-columns {
    height: 1fr;
}
#group-pane {
    width: 35%;
    min-width: 22;
    padding-right: 1;
}
#node-pane {
    width: 1fr;
    border-left: solid $panel-divider;
    padding-left: 1;
}
#group-info {
    height: 3;
    margin-top: 1;
    color: $primary;
}
#proxy-search {
    margin-bottom: 1;
}
DataTable {
    height: 1fr;
    border: solid $panel-divider;
    background: $background;
    scrollbar-size-horizontal: 1;
    scrollbar-size-vertical: 1;
}
DataTable:focus {
    border: solid $primary;
}
DataTable > .datatable--header {
    background: $surface;
    color: $foreground;
    text-style: bold;
}
DataTable > .datatable--even-row {
    background: $background;
}
DataTable > .datatable--odd-row {
    background: #102130;
}
DataTable > .datatable--cursor {
    background: #1b4059;
    color: $foreground;
}
DataTable:focus > .datatable--cursor {
    background: $primary;
    color: $background;
    text-style: bold;
}
.dashboard-panel DataTable, .dashboard-panel DataTable:focus {
    border: none;
}
.hint {
    height: auto;
    color: $text-muted;
    padding: 0 1;
    margin-bottom: 1;
}
#connection-sort {
    width: 21;
}
#log-level {
    width: 14;
    margin-right: 1;
}
#pause-logs {
    width: 18;
}
#clear-logs {
    min-width: 8;
    width: 8;
}
#log-output {
    height: 1fr;
    border: solid $panel-border;
    padding: 0 1;
    background: $background;
}
#log-output:focus {
    border: solid $primary;
}
.config-form {
    height: auto;
    max-width: 90;
    padding: 1 2;
    border: solid $panel-border;
    margin-bottom: 1;
}
.config-row {
    height: 3;
    align-vertical: middle;
}
.config-row Label {
    width: 24;
    height: 3;
    content-align: left middle;
}
.config-row Input, .config-row Select, .config-row Checkbox {
    width: 1fr;
}
Confirm, Information {
    align: center middle;
    background: $background 75%;
}
.dialog {
    width: 85%;
    max-width: 100;
    height: 85%;
    padding: 1 2;
    border: solid $primary;
    background: $surface;
}
.dialog VerticalScroll {
    height: 1fr;
    margin-bottom: 1;
}
.dialog Static {
    height: auto;
}
.confirm-dialog {
    height: auto;
    max-height: 85%;
}
.confirm-dialog .toolbar {
    align-horizontal: right;
}
.narrow #metrics {
    grid-size: 2 2;
    grid-gutter: 1 1;
    height: 9;
}
.narrow #overview-grid {
    grid-size: 1 6;
    grid-columns: 1fr;
    grid-rows: 14 13 12 12 10 11;
    height: 77;
}
.narrow ContentTabs Tab {
    padding: 0 1;
}
.narrow #proxy-columns {
    layout: vertical;
    overflow-y: auto;
}
.narrow #group-pane {
    width: 1fr;
    min-height: 8;
    height: 8;
    padding: 0;
}
.narrow #node-pane {
    width: 1fr;
    min-height: 12;
    height: 1fr;
    border-left: none;
    padding: 0;
}
.narrow .toolbar Button {
    min-width: 6;
    margin-right: 0;
}
