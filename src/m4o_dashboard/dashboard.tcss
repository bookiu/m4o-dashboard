Screen {
    background: $background;
    color: $foreground;
    padding: 0 1;
}
#network-status, #dashboard-footer {
    height: auto;
    min-height: 3;
    border: solid $panel-border;
    padding: 0 1;
    background: $background;
}
#network-status {
    max-height: 7;
}
#dashboard-footer {
    height: 3;
}
#pages {
    height: 1fr;
}
ContentTabs {
    height: 2;
    border-bottom: solid $panel-divider;
    margin-bottom: 0;
}
ContentTabs Underline {
    display: none;
}
Tab {
    height: 1;
    padding: 0 2;
    color: $foreground;
    background: $background;
}
Tab.-active, Tabs:focus Tab.-active {
    color: $background;
    background: $primary;
    text-style: bold;
}
TabPane {
    padding: 0;
}
Overview, Proxies, Rules, Connections, Logs, KernelConfig {
    height: 1fr;
}
Overview {
    scrollbar-size-vertical: 1;
}
#metrics {
    layout: grid;
    grid-size: 4 1;
    grid-gutter: 0 1;
    height: 4;
    margin-bottom: 1;
}
.metric {
    height: 4;
    padding: 0 1;
    border: solid $panel-border;
    background: $background;
}
.metric-label, .metric-value {
    height: 1;
}
.metric-label {
    color: $foreground;
}
.metric-value {
    text-style: bold;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}
#overview-grid {
    layout: grid;
    grid-size: 2 3;
    grid-columns: 8fr 5fr;
    grid-rows: 1.2fr 1fr 1fr;
    grid-gutter: 1 1;
    height: 1fr;
    min-height: 32;
}
.dashboard-panel {
    border: solid $panel-border;
    padding: 0 1;
    background: $background;
}
.panel-heading {
    height: 2;
    width: 1fr;
    border-bottom: solid $panel-divider;
    color: $primary;
    text-style: bold;
}
.panel-title {
    width: 1fr;
    height: 1;
}
.panel-action {
    height: 1;
    width: auto;
    min-width: 0;
    border: none;
    padding: 0 0 0 1;
    background: transparent;
    color: $foreground;
    text-style: none;
}
.panel-action:hover, .panel-action:focus {
    border: none;
    background: $primary;
    color: $background;
}
.panel-hint {
    height: 1;
    color: $text-muted;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}
#traffic-legend {
    width: auto;
    height: 1;
}
#traffic-chart {
    height: 1fr;
}
.route-label {
    height: 1;
    color: $text-muted;
}
#mode-options {
    height: 1;
}
.mode-button {
    height: 1;
    width: 1fr;
    min-width: 0;
    border: none;
    padding: 0;
    background: $background;
    color: $foreground;
    text-style: none;
}
.mode-button.selected-mode {
    color: $primary;
}
.mode-button:focus, .mode-button:hover {
    background: $primary;
    color: $background;
    border: none;
}
#quick-group {
    height: 1;
    margin-bottom: 1;
}
#quick-group SelectCurrent {
    border: none;
    padding: 0;
}
#overview-config {
    min-height: 5;
}
#overview-logs, #overview-config {
    height: 1fr;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}
.section-title {
    color: $primary;
    text-style: bold;
    margin: 1 0;
    height: auto;
}
.toolbar {
    height: 3;
    margin: 1 0;
    align-vertical: middle;
}
.toolbar Button {
    margin-right: 1;
    min-width: 10;
}
.toolbar Input {
    width: 1fr;
    min-width: 10;
    margin-right: 1;
}
Input {
    border: tall $panel-divider;
    background: $surface;
}
Input:focus {
    border: tall $primary;
}
Button {
    background: $surface;
}
#proxy-columns {
    height: 1fr;
}
#group-pane {
    width: 35%;
    min-width: 22;
    padding-right: 1;
}
#node-pane {
    width: 1fr;
    border-left: solid $panel-divider;
    padding-left: 1;
}
#group-info {
    height: 3;
    margin-top: 1;
    color: $primary;
}
#proxy-search {
    margin-bottom: 1;
}
DataTable {
    height: 1fr;
    border: solid $panel-divider;
    background: $background;
    scrollbar-size-horizontal: 1;
    scrollbar-size-vertical: 1;
}
DataTable:focus {
    border: solid $primary;
}
DataTable > .datatable--header {
    background: $surface;
    color: $foreground;
    text-style: bold;
}
DataTable > .datatable--even-row {
    background: $background;
}
DataTable > .datatable--odd-row {
    background: #102130;
}
DataTable > .datatable--cursor {
    background: #1b4059;
    color: $foreground;
}
DataTable:focus > .datatable--cursor {
    background: $primary;
    color: $background;
    text-style: bold;
}
.dashboard-panel DataTable, .dashboard-panel DataTable:focus {
    border: none;
}
.hint {
    height: auto;
    color: $text-muted;
    padding: 0 1;
    margin-bottom: 1;
}
#connection-sort {
    width: 21;
}
#log-level {
    width: 14;
    margin-right: 1;
}
#pause-logs {
    width: 18;
}
#clear-logs {
    min-width: 8;
    width: 8;
}
#log-output {
    height: 1fr;
    border: solid $panel-border;
    padding: 0 1;
    background: $background;
}
#log-output:focus {
    border: solid $primary;
}
.config-form {
    height: auto;
    max-width: 90;
    padding: 1 2;
    border: solid $panel-border;
    margin-bottom: 1;
}
.config-row {
    height: 3;
    align-vertical: middle;
}
.config-row Label {
    width: 24;
    height: 3;
    content-align: left middle;
}
.config-row Input, .config-row Select, .config-row Checkbox {
    width: 1fr;
}
Confirm, Information {
    align: center middle;
    background: $background 75%;
}
.dialog {
    width: 85%;
    max-width: 100;
    height: 85%;
    padding: 1 2;
    border: solid $primary;
    background: $surface;
}
.dialog VerticalScroll {
    height: 1fr;
    margin-bottom: 1;
}
.dialog Static {
    height: auto;
}
.confirm-dialog {
    height: auto;
    max-height: 85%;
}
.confirm-dialog .toolbar {
    align-horizontal: right;
}
.narrow #metrics {
    grid-size: 2 2;
    grid-gutter: 1 1;
    height: 9;
}
.narrow #overview-grid {
    grid-size: 1 6;
    grid-columns: 1fr;
    grid-rows: 14 13 12 12 10 11;
    height: 77;
}
.narrow ContentTabs Tab {
    padding: 0 1;
}
.narrow #proxy-columns {
    layout: vertical;
    overflow-y: auto;
}
.narrow #group-pane {
    width: 1fr;
    min-height: 8;
    height: 8;
    padding: 0;
}
.narrow #node-pane {
    width: 1fr;
    min-height: 12;
    height: 1fr;
    border-left: none;
    padding: 0;
}
.narrow .toolbar Button {
    min-width: 6;
    margin-right: 0;
}

/* Detailed pages share the reference's thin panels and generous inspector columns. */
Proxies, Rules, Connections, Logs, KernelConfig {
    overflow-y: auto;
    scrollbar-size-vertical: 1;
}
.page-panel {
    border: solid $panel-border;
    padding: 0 1;
    background: $background;
}
.page-panel DataTable, .page-panel DataTable:focus {
    border: none;
}
.page-panel DataTable > .datatable--cursor {
    background: $primary;
    color: $background;
}
.page-panel Static {
    height: auto;
}
.page-panel .panel-heading {
    height: 2;
    margin-bottom: 1;
}
.page-panel .panel-hint {
    height: 1;
}
.stat-strip {
    height: 4;
    margin-bottom: 1;
}
.stat-card {
    width: 1fr;
    height: 4;
    border: solid $panel-border;
    padding: 0 1;
    margin-right: 1;
}
.stat-card:last-child { margin-right: 0; }
.compact-toolbar {
    height: 3;
    align-vertical: middle;
}
.compact-toolbar Input {
    height: 3;
    width: 1fr;
    min-width: 12;
    margin-right: 1;
}
.compact-toolbar Select {
    width: 17;
    height: 3;
    margin-right: 1;
}
SelectCurrent {
    border: solid $panel-divider;
    background: $background;
}
.compact-toolbar SelectCurrent { height: 3; }
.wide-action {
    width: 1fr;
    min-width: 0;
    height: 3;
    padding: 0 1;
    border: solid $panel-divider;
    background: $background;
    color: $foreground;
    text-style: none;
}
.wide-action:focus, .wide-action:hover, #apply-config {
    background: $primary;
    color: $background;
    border: solid $primary;
}
#proxy-columns { height: 1fr; min-height: 35; }
#group-pane {
    width: 22%;
    min-width: 25;
    margin-right: 1;
    padding: 0 1;
}
#groups { height: 1fr; }
.group-help { height: 5; border-top: solid $panel-divider; padding-top: 1; }
#proxy-main { width: 1fr; }
#proxy-toolbar { height: 3; margin-bottom: 1; padding: 0; }
#proxy-summary { width: 23; height: 1; }
#proxy-toolbar Input { height: 1; border: none; }
.proxy-mode {
    width: 12;
    min-width: 10;
    height: 1;
    border: none;
    padding: 0;
    background: $background;
}
.proxy-mode.selected-mode { color: $primary; }
#node-pane { height: 1fr; width: 1fr; min-height: 14; padding: 0 1; }
#group-info { margin: 0; height: 2; }
.node-current { height: 2; border-bottom: solid $panel-divider; }
#current-node { width: 1fr; }
#proxy-bottom { height: 15; margin-top: 1; }
#node-detail-panel { width: 1fr; margin-right: 1; }
#switch-panel { width: 1fr; }
#switch-preview { height: 6; }
#rules-layout { height: 1fr; min-height: 33; }
#rules-main { width: 2fr; margin-right: 1; }
#rules-sidebar { width: 1fr; min-width: 32; }
#rules-list-panel { height: 1fr; }
#raw-rule-panel { height: 6; margin-top: 1; }
#rule-detail-panel { height: 3fr; }
#providers-panel { height: 2fr; min-height: 14; margin-top: 1; }
#providers-table { min-height: 5; }
#connections-layout { height: 1fr; min-height: 33; }
#connections-main { width: 3fr; margin-right: 1; }
#connection-filters { margin-bottom: 1; padding: 0; }
#connection-filters Select { width: 15; }
#connection-list-panel { height: 1fr; min-height: 12; }
#connection-inspector { width: 1.1fr; min-width: 30; }
#connection-inspector .panel-heading { margin-top: 1; }
#connection-traffic-panel { height: 14; margin-top: 1; }
#connection-traffic-body { height: 1fr; }
#connection-traffic-stats { width: 27; border-right: solid $panel-divider; }
#connection-chart { width: 1fr; height: 1fr; }
#log-toolbar { margin-bottom: 1; padding: 0; }
#log-level { width: 20; }
#log-autoscroll { width: 17; height: 1; border: none; padding: 0; }
#log-toolbar .panel-action { width: auto; padding: 0 1; }
#log-layout { height: 1fr; min-height: 27; }
#log-list-panel { width: 7fr; margin-right: 1; }
#log-output, #log-output:focus { height: 1fr; border: none; padding: 0; }
#log-sidebar { width: 3fr; min-width: 30; }
#log-detail-panel { height: 1fr; }
#log-message { margin-bottom: 1; }
#log-controls { height: 9; margin-top: 1; }
#log-controls .panel-heading { margin-bottom: 0; }
#config-layout { height: 1fr; min-height: 36; }
#config-sidebar { width: 21%; min-width: 23; margin-right: 1; }
#config-categories { height: 15; }
#config-file-name { margin-bottom: 1; }
#config-editor { width: 47%; margin-right: 1; }
#config-review { width: 1fr; min-width: 32; }
#config-preview-panel { height: 1fr; min-height: 12; margin-bottom: 1; }
#config-actions { height: 23; }
#general-fields, #port-fields, #config-other { height: auto; }
#config-other { padding: 1 0; }
.config-row { height: 3; }
.config-row Label { width: 1fr; height: 3; }
.config-row Input, .config-row Select { width: 21; height: 3; }
.config-row Checkbox { width: 21; height: 3; padding: 0; }
.config-row .changed-marker { width: 3; color: $warning; text-align: center; }
.config-explanation { height: auto; margin: 1 0; color: $text-muted; }
.narrow .stat-strip { height: 4; }
.narrow #proxy-columns { layout: horizontal; min-height: 38; }
.narrow #group-pane { width: 24; height: 1fr; min-height: 0; padding: 0 1; }
.narrow #proxy-summary { display: none; }
.narrow .proxy-mode { width: 10; min-width: 8; }
.narrow #proxy-toolbar { height: 5; layout: grid; grid-size: 3 2; }
.narrow #proxy-search { column-span: 3; }
.narrow #node-pane { height: 1fr; border: solid $panel-border; padding: 0 1; }
.narrow #proxy-bottom { height: 18; }
.narrow #rules-layout, .narrow #connections-layout, .narrow #log-layout {
    layout: vertical;
    height: auto;
}
.narrow #rules-main, .narrow #connections-main, .narrow #log-list-panel {
    width: 1fr;
    height: 32;
    margin-right: 0;
}
.narrow #rules-sidebar { width: 1fr; height: 33; margin-top: 1; }
.narrow #connection-inspector { width: 1fr; height: 44; margin-top: 1; }
.narrow #log-sidebar { width: 1fr; height: 30; margin-top: 1; }
.narrow #log-autoscroll { display: none; }
.narrow #config-layout { layout: vertical; height: auto; }
.narrow #config-sidebar { width: 1fr; height: 15; margin-right: 0; }
.narrow #config-categories { height: 8; }
.narrow #config-sidebar .panel-heading { margin: 0; }
.narrow #config-file-name, .narrow #config-connection-status { display: none; }
.narrow #config-editor { width: 1fr; height: 37; margin: 1 0; }
.narrow #config-review { width: 1fr; height: 40; }
#connection-filters, #log-toolbar { height: 5; }
#switch-panel .panel-heading { margin-bottom: 0; }
#switch-preview { height: 5; }
#refresh-rules { height: 1; border: none; padding: 0; }
#providers-panel { min-height: 15; }
#connection-inspector .panel-heading { margin-top: 0; margin-bottom: 0; }
#connection-inspector .wide-action { height: 2; border: none; }
#connection-details { margin-bottom: 1; }
#config-editor > .panel-heading { margin-bottom: 0; }
#config-actions { height: 22; }
#config-actions .panel-heading { margin-bottom: 0; }
#config-actions .wide-action { margin: 0; }
#log-detail-panel .panel-heading, #rule-detail-panel .panel-heading { margin-bottom: 0; }
